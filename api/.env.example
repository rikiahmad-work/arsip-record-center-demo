APP_NAME=SiARSIP-API
APP_PORT=8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siarsip
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_ACCESS_EXPIRATION_HOURS=7
JWT_REFRESH_EXPIRATION_HOURS=30

CORS_ALLOWED_ORIGINS=http://localhost:3000

RATE_LIMIT_API=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW_MINUTES=1

STORAGE_PATH=./storage/dokumen
MAX_UPLOAD_MB=10

MFA_REQUIRED=true
MFA_ISSUER=SiARSIP
MFA_ENCRYPTION_KEY=your-32-byte-hex-or-base64-aes-256-gcm-key
RATE_LIMIT_MFA=5

